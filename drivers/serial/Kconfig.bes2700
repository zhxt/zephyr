config UART_BES2700
	bool "BES2700 BTH UART"
	default y
	depends on DT_HAS_BESTECHNIC_BES2700_BTH_UART_ENABLED
	select SERIAL_HAS_DRIVER
	help
	  Polling UART using the clock and pins prepared by the loader.
	  Supports fixed 8N1 without flow control.
