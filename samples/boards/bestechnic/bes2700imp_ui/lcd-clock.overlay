/* Keep the Zephyr image below the LCDC frame buffer reserved by the board. */
&cpu0 {
	clock-frequency = <48000000>;
};

/ {
	chosen {
		zephyr,sram = &lcd_sram;
	};

	lcd_sram: memory@20010000 {
		compatible = "mmio-sram";
		reg = <0x20010000 0x24000>;
	};
};
